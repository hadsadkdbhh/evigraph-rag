{
  "title": "EviGraph FinQA 600-Example Local Program Planner Growth-Comparison Repair v40",
  "config": "configs/default_local_planner.yaml",
  "output_dir": "outputs/eval/finqa_600_local_planner_growth_comparison_v40",
  "datasets": [
    {
      "name": "finqa_600_subset",
      "raw_questions": "data/raw/finqa_600_subset.jsonl",
      "questions": "outputs/eval/finqa_600_local_planner_growth_comparison_v40/finqa_questions.jsonl",
      "field_map": {
        "id": "id",
        "query": "question",
        "answer": "answer",
        "source_doc": "source_doc",
        "task_type": "task_type"
      },
      "corpus": "data/finqa_600_corpus",
      "build_index": true,
      "index": "outputs/index/finqa_600_subset.json",
      "chunk_size": 1200,
      "chunk_overlap": 160,
      "gate": {
        "min_records": 600,
        "min_source_doc_coverage": 1.0,
        "fail_on_error": true
      }
    }
  ],
  "experiments": [
    {
      "name": "oracle_doc_full_local_planner_v40_growth_comparison",
      "type": "batch",
      "retrieval_mode": "oracle_doc",
      "methods": ["full_evigraph"]
    },
    {
      "name": "open_bm25_full_local_planner_v40_growth_comparison",
      "type": "batch",
      "retrieval_mode": "open",
      "methods": ["full_evigraph"]
    },
    {
      "name": "source_rerank_full_local_planner_v40_growth_comparison",
      "type": "batch",
      "retrieval_mode": "source_rerank",
      "methods": ["full_evigraph"]
    }
  ],
  "limitations": [
    "This manifest carries forward v39 source-anchored verifier-guided repair.",
    "It adds a bounded reconciliation-table operation for queries asking for the growth of one row in comparison with the growth of another row over two years.",
    "The target failure pattern is source-available but unsupported textual fallback on FRT-style additions-versus-deductions growth comparisons."
  ]
}
