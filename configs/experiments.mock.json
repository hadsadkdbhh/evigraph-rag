{
  "title": "EviGraph Mock Evidence Study",
  "config": "configs/default.yaml",
  "output_dir": "outputs/eval/manifest",
  "datasets": [
    {
      "name": "mock_report",
      "raw_questions": "data/raw/mock_external.jsonl",
      "questions": "outputs/eval/manifest/mock_report_questions.jsonl",
      "field_map": {
        "id": "qid",
        "query": "question",
        "answer": "gold_answer",
        "source_doc": "document",
        "task_type": "category"
      },
      "corpus": "data/corpus",
      "build_index": true,
      "index": "outputs/index/mock_report_manifest.json",
      "chunk_size": 900,
      "chunk_overlap": 120
    }
  ],
  "experiments": [
    {
      "name": "ablation",
      "type": "batch",
      "methods": [
        "topk",
        "utility_only",
        "evigraph_wo_risk",
        "evigraph_wo_verifier",
        "evigraph_wo_support",
        "full_evigraph"
      ]
    },
    {
      "name": "pareto",
      "type": "pareto",
      "method": "full_evigraph",
      "budgets": [1, 2, 4, 8]
    }
  ],
  "limitations": [
    "The mock dataset has one example and is only a pipeline smoke test.",
    "The local corpus is a tiny surrogate, not a real benchmark corpus.",
    "Retrieval is lexical BM25-style rather than dense or multimodal retrieval.",
    "Chart and table evidence is represented through text/table surrogates."
  ]
}
