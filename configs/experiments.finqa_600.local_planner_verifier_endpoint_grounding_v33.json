      "methods": ["full_evigraph"]
    },
    {
      "name": "open_bm25_full_local_planner_v33_verifier_endpoint_grounding",
      "type": "batch",
      "retrieval_mode": "open",
      "methods": ["full_evigraph"]
    },
    {
      "name": "source_rerank_full_local_planner_v33_verifier_endpoint_grounding",
      "type": "batch",
      "retrieval_mode": "source_rerank",
      "methods": ["full_evigraph"]
    }
  ],
  "limitations": [
    "This manifest evaluates bounded verifier grounding for reconciliation-table endpoint rows.",
    "It accepts ending/beginning balance rows only when the query and supporting context name unrecognized tax benefits.",
    "It is intended to prevent verifier-guided repair or grounded rejection from replacing a correct endpoint-row calculation with a weaker intermediate-row operand."
  ]
