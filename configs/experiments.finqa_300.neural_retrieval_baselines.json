{
  "title": "EviGraph FinQA 300-Example Neural Retrieval Baselines",
  "config": "configs/default_local_planner.yaml",
  "output_dir": "outputs/eval/finqa_300_neural_retrieval_baselines",
  "datasets": [
    {
      "name": "finqa_300_subset",
      "raw_questions": "data/raw/finqa_300_subset.jsonl",
      "questions": "outputs/eval/finqa_300_neural_retrieval_baselines/finqa_questions.jsonl",
      "field_map": {
        "id": "id",
        "query": "question",
        "answer": "answer",
        "source_doc": "source_doc",
        "task_type": "task_type"
      },
      "corpus": "data/finqa_300_corpus",
      "build_index": true,
      "index": "outputs/index/finqa_300_subset.json",
      "chunk_size": 1200,
      "chunk_overlap": 160,
      "gate": {
        "min_records": 300,
        "min_source_doc_coverage": 1.0,
        "fail_on_error": true
      }
    }
  ],
  "experiments": [
    {
      "name": "open_bm25_baseline",
      "type": "batch",
      "retrieval_mode": "open",
      "methods": ["direct_rag", "retrieve_then_program", "full_evigraph"]
    },
    {
      "name": "open_neural_dense_baseline",
      "type": "batch",
      "retrieval_mode": "open_neural_dense",
      "methods": ["direct_rag", "retrieve_then_program", "full_evigraph"]
    },
    {
      "name": "open_neural_hybrid_baseline",
      "type": "batch",
      "retrieval_mode": "open_neural_hybrid",
      "methods": ["direct_rag", "retrieve_then_program", "full_evigraph"]
    }
  ],
  "limitations": [
    "This manifest requires sentence-transformers and a downloaded embedding model.",
    "Set EVIGRAPH_NEURAL_DENSE_MODEL to override the default sentence-transformers/all-MiniLM-L6-v2 model.",
    "The neural hybrid retriever combines sentence-transformer cosine similarity, normalized BM25, and lightweight numeric/table overlap features."
  ]
}
