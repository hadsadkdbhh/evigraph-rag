{
  "title": "TAT-QA-20 Cross-Benchmark Pilot",
  "config": "configs/default_local_planner.yaml",
  "output_dir": "outputs/eval/tatqa_20_local_planner",
  "datasets": [
    {
      "name": "tatqa_20",
      "questions": "data/raw/tatqa_20_subset.jsonl",
      "corpus": "data/tatqa_20_corpus",
      "build_index": true,
      "index": "outputs/index/tatqa_20_subset.json",
      "chunk_size": 1200,
      "chunk_overlap": 160,
      "retrieval_mode": "oracle_doc",
      "gate": {
        "min_records": 20,
        "min_source_doc_coverage": 1.0,
        "fail_on_error": true
      }
    }
  ],
  "experiments": [
    {
      "name": "oracle_doc_ablation",
      "type": "batch",
      "retrieval_mode": "oracle_doc",
      "methods": [
        "topk",
        "utility_only",
        "retrieve_then_program",
        "full_evigraph"
      ],
      "progress_every": 10
    },
    {
      "name": "open_bm25_full",
      "type": "batch",
      "retrieval_mode": "open",
      "methods": [
        "full_evigraph"
      ],
      "progress_every": 5
    }
  ],
  "limitations": [
    "This is a small public cross-benchmark pilot, not a full TAT-QA benchmark result.",
    "The subset is sampled from arithmetic TAT-QA dev questions with a fixed seed.",
    "Gold answers are used only for evaluation; gold derivations are not serialized into the retrieval corpus."
  ]
}
