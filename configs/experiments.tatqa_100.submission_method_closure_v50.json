{
  "title": "TAT-QA-100 Submission Method Closure v50",
  "config": "configs/default_local_planner.yaml",
  "output_dir": "outputs/eval/tatqa_100_submission_method_closure_v50",
  "datasets": [
    {
      "name": "tatqa_100",
      "questions": "data/raw/tatqa_100_subset.jsonl",
      "corpus": "data/tatqa_100_corpus",
      "build_index": true,
      "index": "outputs/index/tatqa_100_submission_method_closure_v50.json",
      "chunk_size": 1200,
      "chunk_overlap": 160,
      "retrieval_mode": "oracle_doc",
      "gate": {
        "min_records": 100,
        "min_source_doc_coverage": 1.0,
        "fail_on_error": true
      }
    }
  ],
  "experiments": [
    {
      "name": "oracle_doc_method_closure_v50",
      "type": "batch",
      "retrieval_mode": "oracle_doc",
      "methods": [
        "direct_rag",
        "retrieve_then_program",
        "utility_only",
        "evigraph_wo_operation_planner",
        "full_evigraph"
      ],
      "progress_every": 20
    },
    {
      "name": "open_bm25_method_closure_v50",
      "type": "batch",
      "retrieval_mode": "open",
      "methods": [
        "direct_rag",
        "retrieve_then_program",
        "utility_only",
        "evigraph_wo_operation_planner",
        "full_evigraph"
      ],
      "progress_every": 20
    }
  ],
  "limitations": [
    "This small cross-benchmark closure run checks whether method ordering is sensible on TAT-QA-100, not just whether Full EviGraph passes the portability gate.",
    "It is intentionally limited to oracle-doc, open BM25, and five methods to avoid spending time on a full second-benchmark ablation.",
    "Use outputs/eval/tatqa_100_portability_v50 as the main TAT-QA Full EviGraph result."
  ]
}
