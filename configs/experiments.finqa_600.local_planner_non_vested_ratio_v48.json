{
  "title": "EviGraph FinQA-600 Non-Vested Ratio v48 Regression",
  "config": "configs/default_local_planner.yaml",
  "output_dir": "outputs/eval/finqa_600_local_planner_non_vested_ratio_v48",
  "datasets": [
    {
      "name": "finqa_600_subset",
      "raw_questions": "data/raw/finqa_600_subset.jsonl",
      "questions": "outputs/eval/finqa_600_local_planner_non_vested_ratio_v48/finqa_questions.jsonl",
      "field_map": {
        "id": "id",
        "query": "question",
        "answer": "answer",
        "source_doc": "source_doc",
        "task_type": "task_type"
      },
      "corpus": "data/finqa_600_corpus",
      "build_index": true,
      "index": "outputs/index/finqa_600_non_vested_ratio_v48.json",
      "chunk_size": 1200,
      "chunk_overlap": 160,
      "gate": {
        "min_records": 600,
        "min_source_doc_coverage": 1.0,
        "fail_on_error": true
      }
    }
  ],
  "experiments": [
    {
      "name": "oracle_doc_full_local_planner_v48_non_vested_ratio",
      "type": "batch",
      "retrieval_mode": "oracle_doc",
      "methods": ["full_evigraph"],
      "progress_every": 50
    },
    {
      "name": "open_bm25_full_local_planner_v48_non_vested_ratio",
      "type": "batch",
      "retrieval_mode": "open",
      "methods": ["full_evigraph"],
      "progress_every": 50
    },
    {
      "name": "source_rerank_full_local_planner_v48_non_vested_ratio",
      "type": "batch",
      "retrieval_mode": "source_rerank",
      "methods": ["full_evigraph"],
      "progress_every": 50
    }
  ],
  "limitations": [
    "This run checks whether the narrow TAT-QA v48 non-vested share activity ratio repair changes FinQA-600.",
    "Compare against outputs/eval/finqa_600_local_planner_direction_repair_v47 and outputs/eval/finqa_600_local_planner_guarded_top8_repair_v43 before updating paper claims.",
    "The goal is regression safety and paired wins/losses, not broad new rule expansion."
  ]
}
