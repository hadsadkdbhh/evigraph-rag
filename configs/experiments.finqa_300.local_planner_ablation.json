{
  "title": "EviGraph FinQA 300-Example Local Program Planner Ablation Study",
  "config": "configs/default_local_planner.yaml",
  "output_dir": "outputs/eval/finqa_300_local_planner_ablation",
  "datasets": [
    {
      "name": "finqa_300_subset",
      "raw_questions": "data/raw/finqa_300_subset.jsonl",
      "questions": "outputs/eval/finqa_300_local_planner_ablation/finqa_questions.jsonl",
      "field_map": {
        "id": "id",
        "query": "question",
        "answer": "answer",
        "source_doc": "source_doc",
        "task_type": "task_type"
      },
      "corpus": "data/finqa_300_corpus",
      "build_index": true,
      "index": "outputs/index/finqa_300_subset.json",
      "chunk_size": 1200,
      "chunk_overlap": 160,
      "gate": {
        "min_records": 300,
        "min_source_doc_coverage": 1.0,
        "fail_on_error": true
      }
    }
  ],
  "experiments": [
    {
      "name": "oracle_doc_ablation",
      "type": "batch",
      "retrieval_mode": "oracle_doc",
      "methods": [
        "topk",
        "utility_only",
        "evigraph_wo_risk",
        "evigraph_wo_operation_planner",
        "evigraph_wo_verifier",
        "evigraph_wo_support",
        "full_evigraph"
      ]
    },
    {
      "name": "open_bm25_ablation",
      "type": "batch",
      "retrieval_mode": "open",
      "methods": [
        "topk",
        "utility_only",
        "evigraph_wo_operation_planner",
        "full_evigraph"
      ]
    },
    {
      "name": "source_rerank_ablation",
      "type": "batch",
      "retrieval_mode": "source_rerank",
      "methods": [
        "topk",
        "utility_only",
        "evigraph_wo_operation_planner",
        "full_evigraph"
      ]
    }
  ],
  "limitations": [
    "This manifest uses the local heuristic program planner and does not require LLM API credentials.",
    "Top-k and utility-only are retrieval/selection baselines with the same local numeric generator.",
    "No-operation-planner keeps the same retrieval, evidence graph, support extraction, and verifier but disables the local program planner fallback.",
    "Oracle-doc no-risk, no-verifier, and no-support ablations isolate graph scoring, verification, and support-subgraph extraction."
  ]
}
