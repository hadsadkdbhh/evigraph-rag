{
  "title": "EviGraph FinQA 600-Example Local Program Planner Soft Operand Verifier v24",
  "config": "configs/default_local_planner.yaml",
  "output_dir": "outputs/eval/finqa_600_local_planner_soft_operand_verifier_v24",
  "datasets": [
    {
      "name": "finqa_600_subset",
      "raw_questions": "data/raw/finqa_600_subset.jsonl",
      "questions": "outputs/eval/finqa_600_local_planner_soft_operand_verifier_v24/finqa_questions.jsonl",
      "field_map": {
        "id": "id",
        "query": "question",
        "answer": "answer",
        "source_doc": "source_doc",
        "task_type": "task_type"
      },
      "corpus": "data/finqa_600_corpus",
      "build_index": true,
      "index": "outputs/index/finqa_600_subset.json",
      "chunk_size": 1200,
      "chunk_overlap": 160,
      "gate": {
        "min_records": 600,
        "min_source_doc_coverage": 1.0,
        "fail_on_error": true
      }
    }
  ],
  "experiments": [
    {
      "name": "oracle_doc_full_local_planner_v24",
      "type": "batch",
      "retrieval_mode": "oracle_doc",
      "methods": ["full_evigraph"]
    },
    {
      "name": "open_bm25_full_local_planner_v24",
      "type": "batch",
      "retrieval_mode": "open",
      "methods": ["full_evigraph"]
    },
    {
      "name": "source_rerank_full_local_planner_v24",
      "type": "batch",
      "retrieval_mode": "source_rerank",
      "methods": ["full_evigraph"]
    }
  ],
  "limitations": [
    "This manifest isolates the v24 soft operand verifier diagnostic on the 600-example FinQA stress subset.",
    "Operand semantic grounding is exposed as a diagnostic and repair-ranking signal, not as a hard answer-support gate.",
    "It uses only the local deterministic planner and does not require API credentials; use the 600-example result as a robustness stress test."
  ]
}
