{
  "title": "EviGraph FinQA 300-Example Local Program Planner Endpoint Repairs v31",
  "config": "configs/default_local_planner.yaml",
  "output_dir": "outputs/eval/finqa_300_local_planner_endpoint_repairs_v31",
  "datasets": [
    {
      "name": "finqa_300_subset",
      "raw_questions": "data/raw/finqa_300_subset.jsonl",
      "questions": "outputs/eval/finqa_300_local_planner_endpoint_repairs_v31/finqa_questions.jsonl",
      "field_map": {
        "id": "id",
        "query": "question",
        "answer": "answer",
        "source_doc": "source_doc",
        "task_type": "task_type"
      },
      "corpus": "data/finqa_300_corpus",
      "build_index": true,
      "index": "outputs/index/finqa_300_subset.json",
      "chunk_size": 1200,
      "chunk_overlap": 160,
      "gate": {
        "min_records": 300,
        "min_source_doc_coverage": 1.0,
        "fail_on_error": true
      }
    }
  ],
  "experiments": [
    {
      "name": "oracle_doc_full_local_planner_v31_endpoint_repairs",
      "type": "batch",
      "retrieval_mode": "oracle_doc",
      "methods": ["full_evigraph"]
    },
    {
      "name": "open_bm25_full_local_planner_v31_endpoint_repairs",
      "type": "batch",
      "retrieval_mode": "open",
      "methods": ["full_evigraph"]
    },
    {
      "name": "source_rerank_full_local_planner_v31_endpoint_repairs",
      "type": "batch",
      "retrieval_mode": "source_rerank",
      "methods": ["full_evigraph"]
    }
  ],
  "limitations": [
    "This manifest evaluates bounded endpoint-row repairs for reconciliation tables.",
    "The repair targets unrecognized-tax-benefit ending/beginning balance percent changes and beginning-to-ending balance percent-change questions.",
    "It preserves the v30 traceable CSV schema with calculation strings for failure diagnostics."
  ]
}
