{
  "title": "EviGraph FinQA 600-Example Local Program Planner Source Window v29",
  "config": "configs/default_local_planner_source_window_v29.yaml",
  "output_dir": "outputs/eval/finqa_600_local_planner_source_window_v29",
  "datasets": [
    {
      "name": "finqa_600_subset",
      "raw_questions": "data/raw/finqa_600_subset.jsonl",
      "questions": "outputs/eval/finqa_600_local_planner_source_window_v29/finqa_questions.jsonl",
      "field_map": {
        "id": "id",
        "query": "question",
        "answer": "answer",
        "source_doc": "source_doc",
        "task_type": "task_type"
      },
      "corpus": "data/finqa_600_corpus",
      "build_index": true,
      "index": "outputs/index/finqa_600_subset.json",
      "chunk_size": 1200,
      "chunk_overlap": 160,
      "gate": {
        "min_records": 600,
        "min_source_doc_coverage": 1.0,
        "fail_on_error": true
      }
    }
  ],
  "experiments": [
    {
      "name": "oracle_doc_full_local_planner_v29_source_window",
      "type": "batch",
      "retrieval_mode": "oracle_doc",
      "methods": ["full_evigraph"]
    },
    {
      "name": "open_bm25_full_local_planner_v29_source_window",
      "type": "batch",
      "retrieval_mode": "open",
      "methods": ["full_evigraph"]
    },
    {
      "name": "source_rerank_full_local_planner_v29_source_window",
      "type": "batch",
      "retrieval_mode": "source_rerank",
      "methods": ["full_evigraph"]
    }
  ],
  "limitations": [
    "This manifest changes only retrieval-side source-local context expansion: adjacent_window is increased from 1 to 2.",
    "The goal is to test whether source-hit/gold-number-missing failures improve without adding new arithmetic rules.",
    "Oracle-doc is included as a stability control; open BM25 and source-rerank are the primary comparisons against v28."
  ]
}
